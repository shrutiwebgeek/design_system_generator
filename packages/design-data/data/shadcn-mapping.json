{
  "meta": {
    "name": "shadcn-mapping",
    "version": "0.5.0",
    "target": "shadcn/ui, Base UI primitives, base-vega style, on Tailwind CSS v4",
    "description": "Read on every token upload. Maps design tokens onto shadcn's CSS variables, Tailwind v4 @theme variables, and rewrites shadcn's hard-coded utility classes onto token utilities.",
    "pathConvention": "Paths starting with 'primitive.' or 'semantic.' are mode-free. Every other path resolves inside each modes.<mode> block of the token file (e.g. 'color.surface.default' -> modes.light.color.surface.default)."
  },

  "cssVars": {
    "--background": "color.surface.default",
    "--foreground": "color.text.default",
    "--card": "color.surface.raised",
    "--card-foreground": "color.text.default",
    "--popover": "color.surface.raised",
    "--popover-foreground": "color.text.default",
    "--primary": "color.action.primary",
    "--primary-foreground": "color.text.inverse",
    "--secondary": "color.action.secondary",
    "--secondary-foreground": "color.text.default",
    "--muted": "color.surface.sunken",
    "--muted-foreground": "color.text.muted",
    "--accent": "color.surface.hover",
    "--accent-foreground": "color.text.default",
    "--destructive": "color.feedback.danger",
    "--border": "color.border.default",
    "--input": "color.border.strong",
    "--ring": "color.focus",
    "--radius": "primitive.radius.lg"
  },

  "theme": {
    "--spacing-ds-none": "primitive.spacing.none",
    "--spacing-ds-xs": "primitive.spacing.xs",
    "--spacing-ds-sm": "primitive.spacing.sm",
    "--spacing-ds-md": "primitive.spacing.md",
    "--spacing-ds-lg": "primitive.spacing.lg",
    "--spacing-ds-xl": "primitive.spacing.xl",
    "--spacing-ds-2xl": "primitive.spacing.2xl",
    "--spacing-ds-control-xs": "primitive.size.control.xs",
    "--spacing-ds-control-sm": "primitive.size.control.sm",
    "--spacing-ds-control-md": "primitive.size.control.md",
    "--spacing-ds-control-lg": "primitive.size.control.lg",
    "--spacing-ds-icon-sm": "primitive.size.icon.sm",
    "--spacing-ds-icon-md": "primitive.size.icon.md",

    "--text-xs": "primitive.fontSize.xs",
    "--text-sm": "primitive.fontSize.sm",
    "--text-md": "primitive.fontSize.md",
    "--text-lg": "primitive.fontSize.lg",
    "--text-xl": "primitive.fontSize.xl",
    "--text-2xl": "primitive.fontSize.2xl",
    "--text-3xl": "primitive.fontSize.3xl",
    "--text-4xl": "primitive.fontSize.4xl",

    "--font-sans": "primitive.fontFamily.sans",
    "--font-mono": "primitive.fontFamily.mono",

    "--font-weight-normal": "primitive.fontWeight.regular",
    "--font-weight-medium": "primitive.fontWeight.medium",
    "--font-weight-semibold": "primitive.fontWeight.semibold",
    "--font-weight-bold": "primitive.fontWeight.bold",

    "--leading-tight": "primitive.lineHeight.tight",
    "--leading-normal": "primitive.lineHeight.normal",
    "--leading-relaxed": "primitive.lineHeight.relaxed",

    "--radius-none": "primitive.radius.none",
    "--radius-sm": "primitive.radius.sm",
    "--radius-md": "primitive.radius.md",
    "--radius-lg": "primitive.radius.lg",
    "--radius-full": "primitive.radius.full",

    "--shadow-sm": "primitive.shadow.sm",
    "--shadow-md": "primitive.shadow.md",
    "--shadow-lg": "primitive.shadow.lg"
  },

  "textStyles": {
    "description": "Each key becomes a Tailwind @utility setting font-family, font-size, font-weight and line-height from the semantic role. Used by organisms and docs pages; shadcn classes are not rewritten to these.",
    "text-display": "semantic.typography.display",
    "text-heading-lg": "semantic.typography.heading.lg",
    "text-heading-md": "semantic.typography.heading.md",
    "text-heading-sm": "semantic.typography.heading.sm",
    "text-body-lg": "semantic.typography.body.lg",
    "text-body-md": "semantic.typography.body.md",
    "text-body-sm": "semantic.typography.body.sm",
    "text-label": "semantic.typography.label",
    "text-caption": "semantic.typography.caption",
    "text-code": "semantic.typography.code"
  },

  "imports": {
    "description": "Module specifiers rewritten in generated components. The generated lib/utils.ts exports a cn() that knows the ds- token utilities; plain cn treats px-ds-md and px-ds-sm as non-conflicting (verified 2026-11-17).",
    "cn": "@/lib/utils"
  },

  "rewrite": {
    "utilityPrefix": {
      "namespace": "spacing",
      "prefix": "ds-",
      "why": "Tailwind v4 also reads --spacing-<name> for w-/max-w-<name>; unprefixed t-shirt names turned max-w-md into 16px (verified 2026-11-17)."
    },
    "unmapped": "snap-and-warn",
    "tieBreak": "down",
    "neverSnapNonZeroToNone": true,

    "spacing": {
      "description": "Tailwind numeric step (x 4px) -> spacing token. Ties round down.",
      "prefixes": [
        "p",
        "px",
        "py",
        "pt",
        "pr",
        "pb",
        "pl",
        "ps",
        "pe",
        "m",
        "mx",
        "my",
        "mt",
        "mr",
        "mb",
        "ml",
        "ms",
        "me",
        "gap",
        "gap-x",
        "gap-y",
        "space-x",
        "space-y",
        "inset",
        "inset-x",
        "inset-y",
        "top",
        "right",
        "bottom",
        "left"
      ],
      "steps": {
        "0": "ds-none",
        "0.5": "ds-xs",
        "1": "ds-xs",
        "1.5": "ds-xs",
        "2": "ds-sm",
        "2.5": "ds-sm",
        "3": "ds-sm",
        "3.5": "ds-md",
        "4": "ds-md",
        "5": "ds-md",
        "6": "ds-lg",
        "7": "ds-lg",
        "8": "ds-xl",
        "9": "ds-xl",
        "10": "ds-xl",
        "11": "ds-2xl",
        "12": "ds-2xl",
        "14": "ds-2xl",
        "16": "ds-2xl"
      }
    },

    "size": {
      "description": "Heights and square sizes. Control heights must line up across buttons and inputs, so they map to size tokens instead of snapping.",
      "prefixes": ["h", "min-h", "size"],
      "steps": {
        "2.5": "ds-icon-sm",
        "3": "ds-icon-sm",
        "3.5": "ds-icon-sm",
        "4": "ds-icon-md",
        "5": "ds-control-xs",
        "8": "ds-control-sm",
        "9": "ds-control-md",
        "10": "ds-control-lg"
      },
      "fallback": "spacing"
    },

    "fontSize": {
      "prefix": "text",
      "steps": { "base": "md", "5xl": "4xl", "6xl": "4xl" }
    },

    "leading": {
      "prefix": "leading",
      "steps": { "none": "tight", "snug": "tight", "loose": "relaxed" }
    },

    "radius": {
      "prefix": "rounded",
      "steps": {
        "": "sm",
        "xs": "sm",
        "xl": "lg",
        "2xl": "lg",
        "3xl": "lg",
        "4xl": "full"
      }
    },

    "shadow": {
      "prefix": "shadow",
      "steps": { "": "sm", "xs": "sm", "xl": "lg", "2xl": "lg" }
    }
  }
}
