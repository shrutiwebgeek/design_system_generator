  "modes": {
    "light": {
      "color": {
        "surface": {
          "default": { "value": "{primitive.color.neutral.50}",  "description": "Page background" },
          "raised":  { "value": "{primitive.color.neutral.0}",   "description": "Cards, popovers" },
          "sunken":  { "value": "{primitive.color.neutral.100}", "description": "Wells, input backgrounds" },
          "hover":   { "value": "{primitive.color.neutral.100}", "description": "Hover background for ghost/outline controls and menu items" }
        },
        "text": {
          "default": { "value": "{primitive.color.neutral.900}", "description": "Body and headings" },
          "muted":   { "value": "{primitive.color.neutral.600}", "description": "Secondary copy, labels" },
          "inverse": { "value": "{primitive.color.neutral.0}",   "description": "Text on action.primary" }
        },
        "border": {
          "default": { "value": "{primitive.color.neutral.200}", "description": "Dividers, card edges" },
          "strong":  { "value": "{primitive.color.neutral.500}", "description": "Input borders" }
        },
        "action": {
          "primary":      { "value": "{primitive.color.blue.600}", "description": "Primary button bg, links" },
          "primaryHover": { "value": "{primitive.color.blue.700}" },
          "secondary":    { "value": "{primitive.color.neutral.100}", "description": "Secondary button bg" }
        },
        "feedback": {
          "success": { "value": "{primitive.color.green.700}" },
          "warning": { "value": "{primitive.color.amber.700}" },
          "danger":  { "value": "{primitive.color.red.600}" },
          "info":    { "value": "{primitive.color.sky.700}" }
        },
        "focus": { "value": "{primitive.color.blue.500}", "description": "Focus ring" }
      }
    },

    "dark": {
