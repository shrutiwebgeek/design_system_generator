        "surface": {
          "default": { "value": "{primitive.color.neutral.900}", "description": "Page background" },
          "raised":  { "value": "{primitive.color.neutral.800}", "description": "Lighter than default — elevation without shadow" },
          "sunken":  { "value": "{primitive.color.neutral.950}", "description": "Wells, input backgrounds" },
          "hover":   { "value": "{primitive.color.neutral.700}", "description": "Hover background for ghost/outline controls and menu items" }
