{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p templates && tsc --noEmit -p preview",
    "templates:sync": "node scripts/templates-sync.ts",
    "test:templates": "vitest run --project templates",
    "test:generated": "vitest run --project generated"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dsg/design-data": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.0"
  }
}
